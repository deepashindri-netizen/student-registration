<div id="message" role="status" aria-live="polite"></div>

<script>
const form = document.getElementById("registrationForm");
const message = document.getElementById("message");
const button = form.querySelector('[type="submit"]');

form.addEventListener("submit", async function(event) {
  event.preventDefault();

  if (!window.Razorpay) {
    message.textContent = "ಪಾವತಿ ಪುಟ ಲೋಡ್ ಆಗಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.";
    return;
  }

  button.disabled = true;
  message.textContent = "ಪಾವತಿ ವಿವರಗಳನ್ನು ಸಿದ್ಧಪಡಿಸಲಾಗುತ್ತಿದೆ...";

  try {
    const data = Object.fromEntries(new FormData(form).entries());

    const response = await fetch("/api/register", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data)
    });

    const order = await response.json();
    if (!response.ok) throw new Error(order.error || "Order ರಚಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ.");

    const checkout = new Razorpay({
      key: order.keyId,
      amount: order.amount,
      currency: order.currency,
      name: order.merchantName,
      description: "ವಿದ್ಯಾರ್ಥಿ ನೋಂದಣಿ ಶುಲ್ಕ",
      order_id: order.orderId,
      prefill: {
        name: data.studentName,
        contact: data.mobile
      },
      handler: async function(payment) {
        message.textContent = "ಪಾವತಿಯನ್ನು ಪರಿಶೀಲಿಸಲಾಗುತ್ತಿದೆ...";

        try {
          const verifyResponse = await fetch("/api/payments/verify", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              registrationId: order.registrationId,
              razorpay_order_id: payment.razorpay_order_id,
              razorpay_payment_id: payment.razorpay_payment_id,
              razorpay_signature: payment.razorpay_signature
            })
          });

          const result = await verifyResponse.json();
          if (!verifyResponse.ok) {
            throw new Error(result.error || "ಪಾವತಿ ದೃಢೀಕರಿಸಲಾಗಲಿಲ್ಲ.");
          }

          message.textContent =
            "ನೋಂದಣಿ ಯಶಸ್ವಿಯಾಗಿದೆ! Registration Number: " +
            result.registrationNumber;
          form.reset();
        } catch (error) {
          message.textContent = error.message +
            " ನಿಮ್ಮ ಪಾವತಿ ಸ್ಥಿತಿಯನ್ನು ಪರಿಶೀಲಿಸಲು ಸಹಾಯಕ್ಕಾಗಿ ಸಂಪರ್ಕಿಸಿ.";
        }
      },
      modal: {
        ondismiss: function() {
          message.textContent =
            "ಪಾವತಿ ಪೂರ್ಣಗೊಂಡಿಲ್ಲ ಅಥವಾ Checkout ಮುಚ್ಚಲಾಗಿದೆ. ಅಗತ್ಯವಿದ್ದರೆ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.";
          button.disabled = false;
        }
      }
    });

    checkout.on("payment.failed", function() {
      message.textContent =
        "ಪಾವತಿ ವಿಫಲವಾಗಿದೆ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.";
      button.disabled = false;
    });

    checkout.open();
  } catch (error) {
    message.textContent = "ದೋಷ: " + error.message;
    button.disabled = false;
  }
});
</script>
